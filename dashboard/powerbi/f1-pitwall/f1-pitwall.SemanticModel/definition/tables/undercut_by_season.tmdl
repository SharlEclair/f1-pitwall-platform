table undercut_by_season

	column season_scope
		dataType: string
		summarizeBy: none
		sourceColumn: season_scope

	column n_attempts
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: n_attempts

	column n_success
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: n_success

	column n_failure
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: n_failure

	column n_inconclusive
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: n_inconclusive

	column n_sessions
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: n_sessions

	column success_rate
		dataType: double
		summarizeBy: none
		sourceColumn: success_rate

	column wilson_low
		dataType: double
		summarizeBy: none
		sourceColumn: wilson_low

	column wilson_high
		dataType: double
		summarizeBy: none
		sourceColumn: wilson_high

	measure 'Primary Decided' = CALCULATE ( SUM ( undercut_by_season[n_success] ) + SUM ( undercut_by_season[n_failure] ), undercut_by_season[season_scope] = "all" )
		formatString: #,0
		displayFolder: "Undercut"

	measure 'Primary Attempts Text' = VAR a = CALCULATE ( SUM ( undercut_by_season[n_attempts] ), undercut_by_season[season_scope] = "all" ) VAR r = CALCULATE ( SUM ( undercut_by_season[n_sessions] ), undercut_by_season[season_scope] = "all" ) RETURN a & " attempts in " & r & " races"
		displayFolder: "Undercut"

	partition undercut_by_season = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\undercut_by_season.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"season_scope", type text}, {"n_attempts", Int64.Type}, {"n_success", Int64.Type}, {"n_failure", Int64.Type}, {"n_inconclusive", Int64.Type}, {"n_sessions", Int64.Type}, {"success_rate", type number}, {"wilson_low", type number}, {"wilson_high", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
