table dim_season

	column season
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: season

	partition dim_season = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_season.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"season", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
