                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "6pt",
                      "fontFamily": "Segoe UI",
                      "color": "#9AA0A6"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Tyres: wear slopes are descriptive; the assumed fuel effect dominates.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontFamily": "Segoe UI",
                      "color": "#E8EAED"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Pit stops: green-flag loss is steady; Safety Car and VSC loss changes sign between seasons.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontFamily": "Segoe UI",
                      "color": "#E8EAED"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Undercut: the rate depends mostly on the starting gap; car pace is not controlled.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontFamily": "Segoe UI",
                      "color": "#E8EAED"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Model: LightGBM beats the linear baseline on three seasons, not on one.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontFamily": "Segoe UI",
                      "color": "#E8EAED"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Data quality: 23 coded rules, quarantine, and reconciled counts end to end.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontFamily": "Segoe UI",
                      "color": "#E8EAED"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
