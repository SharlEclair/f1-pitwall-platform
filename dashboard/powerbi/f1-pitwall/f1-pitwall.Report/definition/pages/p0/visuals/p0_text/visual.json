                      "color": "#9AA0A6"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Every figure is computed from validated data and reproducible from the repository. The page-by-page caveats matter as much as the numbers.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "fontFamily": "Segoe UI",
                      "color": "#9AA0A6"
                    }
